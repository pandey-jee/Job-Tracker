# Supabase Authentication & Storage
VITE_SUPABASE_URL=https://your-supabase-project.supabase.co
VITE_SUPABASE_ANON_KEY=your_supabase_anon_key

# Backend API URL (leave empty in local dev to default to http://localhost:5000/api, or set to your deployed backend URL on Render/Railway)
# Example: VITE_API_URL=https://job-tracker-backend.onrender.com
VITE_API_URL=
